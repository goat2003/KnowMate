APP_ENV=prod
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_DATABASE=knowledge_post_agent
MYSQL_USER=app
MYSQL_PASSWORD=replace-with-app-password
GOFRAME_API_TOKEN=replace-with-http-api-token
AGENT_GRPC_AUTH_TOKEN=replace-with-agent-grpc-token
WECHAT_ENABLED=false
WECHAT_APP_ID_FILE=/run/secrets/wechat_app_id
WECHAT_APP_SECRET_FILE=/run/secrets/wechat_app_secret
WECHAT_TOKEN_FILE=/run/secrets/wechat_token
WECHAT_ENCODING_AES_KEY_FILE=/run/secrets/wechat_encoding_aes_key
WECHAT_OAUTH_REDIRECT_URI=https://your-domain.example/api/wechat/callback
WECHAT_CHAT_PAGE_URL=https://your-domain.example/wechat/chat
WECHAT_SESSION_SECRET_FILE=/run/secrets/wechat_session_secret
WECHAT_ALLOWED_ORIGINS=https://your-domain.example
WECHAT_DEV_ANONYMOUS=false
CRAWLER_CONFIG_PATH=./configs/crawler/prod.sources.example.yaml
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini
MOCK_LLM=false
MOCK_MCP=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
MILVUS_PROVIDER=milvus
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION=user_memory_vectors
NEO4J_PROVIDER=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
MCP_MEMORY_FALLBACK=false
FETCH_MOCK_MODE=false
OTEL_ENABLED=true

# Private Mem_Pro adapter. Keep these values in the deployment secret store.
MEMORY_SERVICE_TOKEN=replace-with-random-internal-token
MEMORY_ROLE_SECRET=replace-with-random-32-byte-secret
MEMORY_BACKEND=mem_pro
MEMORY_PROVIDER_TIMEOUT_SECONDS=30
MEMORY_PROVIDER_BUILD_TIMEOUT_SECONDS=180
LLM_API_KEY=replace-with-memory-llm-key
EMBEDDING_API_KEY=replace-with-memory-embedding-key
MONGODB_URI=mongodb://memory-mongo:27017/
MONGODB_DB_NAME=test_database
WEB_ADMIN_PORT=8088
