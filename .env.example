APP_ENV=dev
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=knowledge_post_agent
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app

# GoFrame backend
GOFRAME_HTTP_ADDR=:8080
AGENT_GRPC_ADDR=127.0.0.1:50051
GOFRAME_API_TOKEN=
GOFRAME_MAX_REQUEST_BODY_BYTES=1048576
GOFRAME_RATE_LIMIT_BURST=120
AGENT_GRPC_AUTH_TOKEN=
MYSQL_DSN=app:change-me-app@tcp(127.0.0.1:3306)/knowledge_post_agent?charset=utf8mb4&parseTime=true&loc=Local
SCHEMA_PATH=../shared/sql/init.sql
CRAWLER_USER_AGENT=KnowMateCrawler/1.0
CRAWLER_REQUEST_TIMEOUT_SECONDS=10
CRAWLER_RETRY_TIMES=3
CRAWLER_RETRY_BACKOFF_MILLISECONDS=250
CRAWLER_MAX_RETRY_DELAY_MILLISECONDS=30000
CRAWLER_PER_HOST_INTERVAL_MILLISECONDS=500
CRAWLER_MAX_RESPONSE_BYTES=5242880
CRAWLER_ROBOTS_CACHE_SECONDS=3600
CRAWLER_SOURCE_MAX_ITEMS=10
CRAWLER_RUN_MAX_ARTICLES=20

# Python agent
AGENT_HOST=0.0.0.0
AGENT_PORT=50051
AGENT_METRICS_PORT=9101
MOCK_LLM=true
MOCK_MCP=true
FETCH_MAX_RESPONSE_BYTES=2097152

# Per-server MCP transports: memory, stdio, or streamable_http
EMBEDDING_MCP_TRANSPORT=memory
FETCH_MCP_TRANSPORT=memory
MILVUS_MCP_TRANSPORT=memory
NEO4J_MCP_TRANSPORT=memory
MCP_MEMORY_FALLBACK=true

# Production memory providers. Keep `memory` for local development.
EMBEDDING_PROVIDER=memory
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.1
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CHARS_PER_CHUNK=12000
EMBEDDING_MAX_CHUNKS=8
EMBEDDING_CACHE_SIZE=1024
EMBEDDING_CACHE_TTL_SECONDS=3600
EMBEDDING_COST_PER_MILLION_TOKENS_USD=

MILVUS_PROVIDER=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=user_memory_vectors
MILVUS_TOKEN=
MILVUS_TOKEN_FILE=
MILVUS_TIMEOUT_SECONDS=10
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

NEO4J_PROVIDER=memory
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_PASSWORD_FILE=
NEO4J_DATABASE=neo4j

# Streamable HTTP endpoints used when the corresponding transport is streamable_http
EMBEDDING_MCP_URL=http://127.0.0.1:7001/mcp
FETCH_MCP_URL=http://127.0.0.1:7002/mcp
MILVUS_MCP_URL=http://127.0.0.1:7003/mcp
NEO4J_MCP_URL=http://127.0.0.1:7004/mcp

# Observability
OTEL_ENABLED=true
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686
ALERTMANAGER_PORT=9093
