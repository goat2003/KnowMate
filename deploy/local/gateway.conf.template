map $http_origin $foreign_origin {
    default 1;
    "" 0;
    "https://localhost:@@PORT@@" 0;
    "https://127.0.0.1:@@PORT@@" 0;
}
map "$request_method:$foreign_origin" $reject_origin {
    default 0;
    ~^(POST|PUT|PATCH|DELETE):1$ 1;
}
server {
    listen 8443 ssl;
    server_name localhost;
    ssl_certificate /etc/local/tls.crt;
    ssl_certificate_key /etc/local/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 2m;
    auth_basic "KnowMate local administrator";
    auth_basic_user_file /etc/local/htpasswd;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    if ($reject_origin) { return 403; }

    # These public callbacks are verified by the backend; keep administrator
    # authentication disabled only for these WeChat routes.
    location = /wechat/callback {
        auth_basic off;
        proxy_pass http://goframe-backend:8080/wechat/callback;
        proxy_set_header Authorization "";
        proxy_set_header X-API-Key "";
        proxy_read_timeout 5s;
    }
    # Web OAuth has a different callback contract from the encrypted service
    # account message callback above. Preserve the /api/wechat prefix.
    location = /api/wechat/callback {
        auth_basic off;
        proxy_pass http://goframe-backend:8080/api/wechat/callback;
        proxy_set_header Authorization "";
        proxy_set_header X-API-Key "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
    }
    location /api/wechat/ {
        auth_basic off;
        proxy_pass http://goframe-backend:8080/wechat/;
        proxy_set_header Authorization "";
        proxy_set_header X-API-Key "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 600s;
    }
    location = /wechat/chat {
        auth_basic off;
        proxy_pass http://web-admin:8080;
        proxy_set_header Authorization "";
    }
    location /assets/ {
        auth_basic off;
        proxy_pass http://web-admin:8080;
        proxy_set_header Authorization "";
    }
    location /api/ {
        proxy_pass http://goframe-backend:8080/;
        proxy_set_header Authorization "Bearer @@TOKEN@@";
        proxy_set_header X-API-Key "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 600s;
    }
    location /monitor/ {
        proxy_pass http://prometheus:9090;
        proxy_set_header Authorization "";
    }
    location /alerts/ {
        proxy_pass http://alertmanager:9093/;
        proxy_set_header Authorization "";
    }
    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Authorization "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /tracing/ {
        proxy_pass http://jaeger:16686;
        proxy_set_header Authorization "";
    }
    location / {
        proxy_pass http://web-admin:8080;
        proxy_set_header Authorization "";
    }
}
